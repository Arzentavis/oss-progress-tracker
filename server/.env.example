# Copy this file to .env and fill in what you have.

PORT=5050

# Optional but recommended: a GitHub personal access token (no scopes needed for public data).
# Without it GitHub only allows ~10 search requests/minute and 60 API calls/hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# AI provider for "what should I do next" suggestions.
# Set ONE of these. If none is set, the app still works using built-in rule-based suggestions.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider when several keys are set (anthropic | gemini | openai | rules)
AI_PROVIDER=

# Optional model overrides
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
